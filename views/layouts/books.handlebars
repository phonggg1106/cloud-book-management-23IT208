<h2>Hệ Thống Quản Lý Sách (Cloud Stateless)</h2>

{{#if error}}
<div class="alert-error">
    <strong>Thông báo:</strong> {{error}}
</div>
{{/if}}

<div class="card">
    <h3>Thêm Sách Mới (Ghi dữ liệu)</h3>
    <form action="/books" method="POST">
        <div class="form-group">
            <label for="bookCode">Mã sản phẩm (Bắt buộc bắt đầu bằng tiền tố "208"):</label>
            <input type="text" id="bookCode" name="bookCode" placeholder="Ví dụ: 208_JAVA_01" required>
        </div>

        <div class="form-group">
            <label for="title">Tên sách:</label>
            <input type="text" id="title" name="title" placeholder="Nhập tên sách" required>
        </div>

        <div class="form-group">
            <label for="price">Giá gốc (VNĐ):</label>
            <input type="number" id="price" name="price" placeholder="Ví dụ: 100000" min="0" required>
        </div>

        <button type="submit">Thêm Sách Vào Database</button>
    </form>
</div>

<div class="card">
    <h3>Danh Sách Sách Hiện Có (Đọc dữ liệu)</h3>
    <table>
        <thead>
            <tr>
                <th>Mã sản phẩm</th>
                <th>Tên sách</th>
                <th>Giá gốc</th>
                <th>VAT (%)</th>
                <th>Giá sau thuế</th>
            </tr>
        </thead>
        <tbody>
            {{#if books.length}}
            {{#each books}}
            <tr>
                <td><strong>{{this.bookCode}}</strong></td>
                <td>{{this.title}}</td>
                <td>{{this.price}} VNĐ</td>
                <td>{{this.vatRate}}%</td>
                <td style="color: #0284c7; font-weight: bold;">{{this.finalPrice}} VNĐ</td>
            </tr>
            {{/each}}
            {{else}}
            <tr>
                <td colspan="5" style="text-align: center; color: #888;">Chưa có dữ liệu sách trong cơ sở dữ liệu.</td>
            </tr>
            {{/if}}
        </tbody>
    </table>
</div>